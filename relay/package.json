{
  "name": "@pocketdock/private-relay",
  "version": "4.0.1",
  "private": true,
  "description": "A bounded two-peer WebSocket relay for PocketDock native remote transfers.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
